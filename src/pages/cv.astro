---
import Layout from '../layouts/Layout.astro';
import { cvData } from '../data/cv';
import PrintButton from '../components/PrintButton';
import { 
  Briefcase, 
  GraduationCap, 
  Languages, 
  CheckCircle2, 
  FileDown, 
  Mail, 
  Phone, 
  MapPin, 
  Award,
  Layers,
  Calendar,
  Building
} from 'lucide-react';
import { GithubIcon } from '../components/SocialIcons';

const { personal, experience, achievements, skillGroups, education, languages } = cvData;
---

<Layout title={`Curriculum Vitae | ${personal.name}`}>
  <div class="space-y-12">
    
    {/* Page Action Bar */}
    <div class="no-print flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-slate-900 p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
      <div>
        <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">
          Curriculum Vitae
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          Verified professional experience, architecture, and skill matrix
        </p>
      </div>

      <div class="flex items-center gap-2.5">
        <PrintButton client:load label="Print / Save PDF" />
        
        <a
          href={personal.pdfUrl}
          download="Igor_Vilghelm_CV.pdf"
          class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white shadow-xs transition-colors"
        >
          <FileDown className="w-4 h-4" />
          <span>Original PDF</span>
        </a>
      </div>
    </div>

    {/* Printable CV Header Card */}
    <div class="glow-card bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 md:p-10 border border-slate-200 dark:border-slate-800 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-b border-slate-200 dark:border-slate-800 pb-8">
        <div class="space-y-2">
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
            {personal.name}
          </h2>
          <p class="text-base sm:text-lg font-semibold text-indigo-600 dark:text-indigo-400">
            {personal.title}
          </p>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed pt-1">
            {personal.about.summary}
          </p>
        </div>

        {/* Contact Strip */}
        <div class="space-y-2.5 text-xs text-slate-600 dark:text-slate-300 shrink-0 bg-slate-50 dark:bg-slate-800/60 p-4 rounded-2xl border border-slate-200/80 dark:border-slate-700/60">
          <div class="flex items-center gap-2">
            <Mail className="w-4 h-4 text-indigo-500 shrink-0" />
            <a href={`mailto:${personal.contacts.email}`} class="font-medium hover:underline text-slate-900 dark:text-white">
              {personal.contacts.email}
            </a>
          </div>
          <div class="flex items-center gap-2">
            <Phone className="w-4 h-4 text-indigo-500 shrink-0" />
            <a href={`tel:${personal.contacts.phone}`} class="font-medium hover:underline text-slate-900 dark:text-white">
              {personal.contacts.phone}
            </a>
          </div>
          <div class="flex items-center gap-2">
            <MapPin className="w-4 h-4 text-indigo-500 shrink-0" />
            <span>{personal.location}</span>
          </div>
          <div class="flex items-center gap-2 pt-1 border-t border-slate-200 dark:border-slate-700">
            <GithubIcon className="w-4 h-4 text-slate-500 shrink-0" />
            <a href={personal.contacts.github} target="_blank" class="hover:underline text-indigo-600 dark:text-indigo-400">
              github.com/igoriok1994
            </a>
          </div>
        </div>
      </div>

      {/* Experience Section */}
      <section class="space-y-8 pt-2">
        <div class="flex items-center gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3">
          <Briefcase className="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white uppercase tracking-wider text-xs">
            Work Experience
          </h3>
        </div>

        {experience.map((company) => (
          <div class="space-y-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
              <div class="flex items-center gap-2">
                <Building className="w-5 h-5 text-slate-400 dark:text-slate-500" />
                <h4 class="text-xl font-black text-slate-900 dark:text-white">
                  {company.company}
                </h4>
              </div>
              <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
                <MapPin className="w-3.5 h-3.5" />
                <span>{company.location}</span>
                <span>•</span>
                <Calendar className="w-3.5 h-3.5" />
                <span>{company.period}</span>
              </div>
            </div>

            {/* Roles timeline */}
            <div class="space-y-8 pl-3 sm:pl-6 border-l-2 border-indigo-500/30 dark:border-indigo-500/20">
              {company.roles.map((role) => (
                <div class="relative space-y-3">
                  {/* Timeline dot */}
                  <div class="absolute -left-[19px] sm:-left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-indigo-600 border-2 border-white dark:border-slate-900"></div>

                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                    <h5 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
                      {role.role}
                    </h5>
                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 self-start sm:self-auto">
                      {role.period}
                    </span>
                  </div>

                  <ul class="space-y-2 pt-1">
                    {role.responsibilities.map((resp) => (
                      <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                        <span class="text-indigo-500 dark:text-indigo-400 font-bold shrink-0 mt-0.5">•</span>
                        <span>{resp}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))}
      </section>

      {/* Key Achievements Section */}
      <section id="achievements" class="space-y-6 pt-4 border-t border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3">
          <Award className="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white uppercase tracking-wider text-xs">
            Key Achievements
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
          {achievements.map((item) => (
            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/70 dark:border-slate-700/60 text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
              <CheckCircle2 className="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span>{item}</span>
            </div>
          ))}
        </div>
      </section>

      {/* Skills Matrix Section */}
      <section id="skills" class="space-y-6 pt-4 border-t border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3">
          <Layers className="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white uppercase tracking-wider text-xs">
            Skills & Technology Stack
          </h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {skillGroups.map((group) => (
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/50 space-y-3">
              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                <span>{group.name}</span>
              </h4>
              <div class="flex flex-wrap gap-1.5">
                {group.skills.map((skill) => (
                  <span class="text-xs px-2.5 py-1 rounded-md bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700/80 font-medium">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* Education & Languages Section */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4 border-t border-slate-200 dark:border-slate-800">
        
        {/* Education */}
        <section class="space-y-4">
          <div class="flex items-center gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3">
            <GraduationCap className="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
            <h3 class="text-lg font-bold text-slate-900 dark:text-white uppercase tracking-wider text-xs">
              Education
            </h3>
          </div>

          <div class="space-y-4">
            {education.map((edu) => (
              <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/50 space-y-1">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-bold text-indigo-600 dark:text-indigo-400">{edu.institution}</span>
                  <span class="text-slate-500 dark:text-slate-400">{edu.period}</span>
                </div>
                <p class="text-sm font-semibold text-slate-900 dark:text-white">
                  {edu.degree}
                </p>
              </div>
            ))}
          </div>
        </section>

        {/* Languages */}
        <section class="space-y-4">
          <div class="flex items-center gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3">
            <Languages className="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
            <h3 class="text-lg font-bold text-slate-900 dark:text-white uppercase tracking-wider text-xs">
              Languages
            </h3>
          </div>

          <div class="space-y-3">
            {languages.map((lang) => (
              <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/70 dark:border-slate-700/50 flex items-center justify-between">
                <span class="text-sm font-bold text-slate-900 dark:text-white">
                  {lang.language}
                </span>
                <span class="text-xs px-2.5 py-1 rounded-md bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 font-medium">
                  {lang.proficiency}
                </span>
              </div>
            ))}
          </div>
        </section>

      </div>

    </div>

  </div>
</Layout>
