---
// Standalone full-screen PDF viewer page (fallback / classic view)
---
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CV, Igor Vilghelm, 2026</title>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #525659;
        }

        .cv-container {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
</head>
<body>

    <iframe 
        id="cv-frame"
        class="cv-container"
        title="CV Viewer">
    </iframe>

    <script is:inline>
      (function() {
        const origin = window.location.origin;
        const pdfUrl = `${origin}/cv.pdf`;
        const frame = document.getElementById('cv-frame');
        if (frame) {
          frame.src = `https://docs.google.com/gview?url=${encodeURIComponent(pdfUrl)}&embedded=true`;
        }
      })();
    </script>

</body>
</html>
