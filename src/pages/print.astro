  {/* Scripts */}
  <script is:inline>
    // View Toggle on Mobile: Responsive vs Scaled A4 Sheet
    const toggleBtn = document.getElementById('toggle-view-btn');
    const toggleText = document.getElementById('toggle-view-text');

    if (toggleBtn && toggleText) {
      toggleBtn.addEventListener('click', () => {
        const isSheet = document.body.classList.toggle('view-sheet');
        toggleText.textContent = isSheet ? 'Mobile' : 'A4 Sheet';
      });
    }

    // Auto-trigger print when URL has ?auto=true
    (function() {
      const params = new URLSearchParams(window.location.search);
      if (params.get('auto') === 'true') {
        const cleanUrl = window.location.pathname;
        window.history.replaceState({}, '', cleanUrl);

        const run = () => setTimeout(() => window.print(), 350);
        if (document.readyState === 'complete') run();
        else window.addEventListener('load', run);
      }
    })();
  </script>

