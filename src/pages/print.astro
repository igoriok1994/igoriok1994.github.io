---
import { cvData } from '../data/cv';
import '../styles/global.css';
import { 
  Mail, 
  Phone, 
  MapPin, 
  Award, 
  GraduationCap, 
  Languages, 
  CheckCircle2, 
  Printer, 
  ArrowLeft, 
  Download,
  Building,
  Layers,
  Globe,
  Database,
  Smartphone
} from 'lucide-react';
import { GithubIcon, LinkedinIcon } from '../components/SocialIcons';

const { personal, experience, achievements, skillGroups, education, languages } = cvData;

const company = experience[0];
const teamLeadRole = company.roles[0];
const fullStackRole = company.roles[1];

// Split full stack role responsibilities across pages for perfect visual balance
const role2Part1 = fullStackRole.responsibilities.slice(0, 5);
const role2Part2 = fullStackRole.responsibilities.slice(5);

// Filter skill groups for page 1 & page 2 left columns
const page1SkillGroups = skillGroups.slice(0, 3);
const page2SkillGroups = skillGroups.slice(3);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{personal.name} – Curriculum Vitae (Print & PDF)</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <style is:inline>
    @page {
      size: A4 portrait;
      margin: 0;
    }

    @media print {
      html, body {
        background: #ffffff !important;
        color: #0f172a !important;
        font-size: 10px !important;
        line-height: 1.35 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .no-print {
        display: none !important;
      }

      .page {
        width: 210mm !important;
        height: 297mm !important;
        max-height: 297mm !important;
        padding: 10mm 12mm !important;
        box-shadow: none !important;
        border: none !important;
        page-break-after: always !important;
        break-after: page !important;
        overflow: hidden !important;
        box-sizing: border-box !important;
        background: #ffffff !important;
      }

      .page:last-child {
        page-break-after: auto !important;
        break-after: auto !important;
      }

      a {
        color: inherit !important;
        text-decoration: none !important;
      }
    }

    @media screen {
      body {
        background-color: #0f172a;
        color: #1e293b;
        min-height: 100vh;
        padding-bottom: 40px;
      }

      .page {
        width: 210mm;
        min-height: 297mm;
        margin: 20px auto;
        padding: 10mm 12mm;
        background: #ffffff;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
        border-radius: 4px;
        box-sizing: border-box;
      }
    }
  </style>
</head>
<body class="font-sans antialiased text-slate-800">

  {/* Screen Floating Action Bar */}
  <div class="no-print sticky top-3 z-50 max-w-xl mx-auto px-4 py-2.5 bg-slate-900/95 backdrop-blur-md border border-slate-700/80 rounded-2xl shadow-2xl flex items-center justify-between text-white my-3">
    <a href="/cv" class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-300 hover:text-white transition-colors">
      <ArrowLeft className="w-3.5 h-3.5" />
      <span>Back to Site</span>
    </a>

    <div class="flex items-center gap-2">
      <button 
        type="button" 
        onclick="window.print()" 
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white shadow-xs transition-colors cursor-pointer"
      >
        <Printer className="w-3.5 h-3.5" />
        <span>Print / Save as PDF</span>
      </button>

      <a 
        href="/cv.pdf" 
        download="Igor_Vilghelm_CV.pdf"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors"
      >
        <Download className="w-3.5 h-3.5" />
        <span>Direct PDF</span>
      </a>
    </div>
  </div>

  {/* ==================== PAGE 1 ==================== */}
  <div class="page flex flex-col justify-between">
    <div>
      {/* Header */}
      <header class="border-b-2 border-indigo-600 pb-3 mb-3.5">
        <div class="flex flex-row justify-between items-start gap-4">
          <div>
            <h1 class="text-2xl font-black tracking-tight text-slate-950 uppercase">
              {personal.name}
            </h1>
            <p class="text-xs font-bold text-indigo-700 mt-0.5 tracking-wide">
              {personal.title}
            </p>
            <p class="text-[10px] text-slate-600 mt-1.5 max-w-lg leading-relaxed">
              {personal.about.summary}
            </p>
          </div>

          {/* Contact Details */}
          <div class="text-[9.5px] space-y-1 text-slate-700 shrink-0 text-right bg-slate-50 p-2.5 rounded-lg border border-slate-200 min-w-[210px]">
            <div class="flex items-center justify-end gap-1.5">
              <a href={`mailto:${personal.contacts.email}`} class="font-semibold text-slate-900 hover:underline">{personal.contacts.email}</a>
              <Mail className="w-3 h-3 text-indigo-600 shrink-0" />
            </div>
            <div class="flex items-center justify-end gap-1.5">
              <a href={`tel:${personal.contacts.phone}`} class="font-medium text-slate-800">{personal.contacts.phone}</a>
              <Phone className="w-3 h-3 text-indigo-600 shrink-0" />
            </div>
            <div class="flex items-center justify-end gap-1.5">
              <span class="text-slate-600">{personal.location}</span>
              <MapPin className="w-3 h-3 text-indigo-600 shrink-0" />
            </div>
            <div class="flex items-center justify-end gap-1.5 pt-1 border-t border-slate-200">
              <a href={personal.contacts.github} class="text-indigo-700 font-medium hover:underline">github.com/igoriok1994</a>
              <GithubIcon className="w-3 h-3 text-slate-700 shrink-0" />
            </div>
            <div class="flex items-center justify-end gap-1.5">
              <a href={personal.contacts.linkedin} class="text-indigo-700 font-medium hover:underline">linkedin.com/in/igor-vilghem</a>
              <LinkedinIcon className="w-3 h-3 text-slate-700 shrink-0" />
            </div>
          </div>
        </div>
      </header>

      {/* Main Page 1 Grid */}
      <div class="grid grid-cols-12 gap-4 items-start">
        
        {/* Left Column (35%) */}
        <aside class="col-span-4 space-y-3.5">
          <section class="space-y-2.5">
            <div class="flex items-center gap-1.5 border-b border-indigo-200 pb-1">
              <Layers className="w-3.5 h-3.5 text-indigo-700" />
              <h2 class="text-[11px] font-black uppercase tracking-wider text-slate-900">
                Core Competencies
              </h2>
            </div>

            <div class="space-y-2">
              {page1SkillGroups.map((group) => (
                <div class="space-y-1">
                  <h3 class="text-[9.5px] font-bold uppercase tracking-wider text-indigo-800">
                    {group.name}
                  </h3>
                  <div class="flex flex-wrap gap-1">
                    {group.skills.map((skill) => (
                      <span class="text-[8.5px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-800 border border-slate-200 font-medium leading-none">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>

          {/* Languages */}
          <section class="space-y-1.5 pt-2 border-t border-slate-200">
            <div class="flex items-center gap-1.5 border-b border-indigo-200 pb-1">
              <Languages className="w-3.5 h-3.5 text-indigo-700" />
              <h2 class="text-[11px] font-black uppercase tracking-wider text-slate-900">
                Languages
              </h2>
            </div>

            <div class="space-y-1 text-[9.5px]">
              {languages.map((lang) => (
                <div class="flex items-center justify-between">
                  <span class="font-bold text-slate-800">{lang.language}</span>
                  <span class="text-slate-600 text-[8.5px] px-1.5 py-0.5 bg-slate-100 rounded border border-slate-200">{lang.proficiency}</span>
                </div>
              ))}
            </div>
          </section>

          {/* Scale Highlights Banner */}
          <div class="p-2.5 rounded-lg bg-indigo-50/70 border border-indigo-100 text-[9px] text-slate-700 space-y-1.5">
            <div class="font-bold text-indigo-900 uppercase tracking-wider text-[9.5px]">Engineering Scale</div>
            <div>• <strong class="text-slate-900">1M+</strong> connected smart metering devices</div>
            <div>• <strong class="text-slate-900">Per-second</strong> time-series aggregation resolution</div>
            <div>• Multi-region deployments across <strong class="text-slate-900">LT, LV & Central Asia</strong></div>
          </div>
        </aside>

        {/* Right Column (65%) */}
        <div class="col-span-8 space-y-3.5 border-l border-slate-200 pl-4">
          <section class="space-y-3">
            <div class="flex items-center gap-1.5 border-b border-indigo-200 pb-1">
              <Building className="w-3.5 h-3.5 text-indigo-700" />
              <h2 class="text-[11px] font-black uppercase tracking-wider text-slate-900">
                Commercial Experience
              </h2>
            </div>

            {/* Company Info */}
            <div class="space-y-3">
              <div class="flex items-baseline justify-between border-b border-slate-100 pb-1">
                <div>
                  <span class="text-sm font-black text-slate-950">{company.company}</span>
                  <span class="text-[10px] text-slate-500 ml-1.5">({company.location})</span>
                </div>
                <span class="text-[10px] font-bold text-indigo-700">{company.period}</span>
              </div>

              {/* Role 1: Team Lead & Full Stack Developer */}
              <div class="space-y-1">
                <div class="flex items-center justify-between">
                  <h3 class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
                    <span>{teamLeadRole.role}</span>
                  </h3>
                  <span class="text-[9px] font-bold text-indigo-700 bg-indigo-50 px-1.5 py-0.5 rounded border border-indigo-100">
                    {teamLeadRole.period}
                  </span>
                </div>

                <ul class="space-y-1 pl-2 text-[9.5px] text-slate-700 leading-snug">
                  {teamLeadRole.responsibilities.map((resp) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-indigo-600 font-bold shrink-0 mt-0.5">•</span>
                      <span>{resp}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {/* Role 2: Full Stack Developer (Part 1) */}
              <div class="space-y-1 pt-1">
                <div class="flex items-center justify-between">
                  <h3 class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
                    <span>{fullStackRole.role}</span>
                  </h3>
                  <span class="text-[9px] font-bold text-slate-600 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">
                    {fullStackRole.period}
                  </span>
                </div>

                <ul class="space-y-1 pl-2 text-[9.5px] text-slate-700 leading-snug">
                  {role2Part1.map((resp) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-indigo-600 font-bold shrink-0 mt-0.5">•</span>
                      <span>{resp}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        </div>

      </div>
    </div>

    {/* Footer Page 1 */}
    <footer class="pt-2 border-t border-slate-200 flex justify-between items-center text-[8.5px] text-slate-500">
      <span>Igor Vilghelm • Curriculum Vitae</span>
      <span>Page 1 of 2</span>
    </footer>
  </div>


  {/* ==================== PAGE 2 ==================== */}
  <div class="page flex flex-col justify-between">
    <div>
      {/* Page 2 Mini Header */}
      <header class="border-b border-indigo-300 pb-2 mb-3.5 flex justify-between items-baseline">
        <div>
          <span class="text-sm font-black uppercase text-slate-950">{personal.name}</span>
          <span class="text-xs text-indigo-700 font-bold ml-2">• {personal.title}</span>
        </div>
        <div class="text-[9px] text-slate-500">
          <span>{personal.contacts.email} • {personal.contacts.phone} • Vilnius, Lithuania</span>
        </div>
      </header>

      {/* Main Page 2 Grid */}
      <div class="grid grid-cols-12 gap-4 items-start">
        
        {/* Left Column (35%) */}
        <aside class="col-span-4 space-y-3.5">
          
          {/* Remaining Skills (Architecture, DB, Security) */}
          <section class="space-y-2.5">
            <div class="flex items-center gap-1.5 border-b border-indigo-200 pb-1">
              <Database className="w-3.5 h-3.5 text-indigo-700" />
              <h2 class="text-[11px] font-black uppercase tracking-wider text-slate-900">
                Databases & Architecture
              </h2>
            </div>

            <div class="space-y-2">
              {page2SkillGroups.map((group) => (
                <div class="space-y-1">
                  <h3 class="text-[9.5px] font-bold uppercase tracking-wider text-indigo-800">
                    {group.name}
                  </h3>
                  <div class="flex flex-wrap gap-1">
                    {group.skills.map((skill) => (
                      <span class="text-[8.5px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-800 border border-slate-200 font-medium leading-none">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>

          {/* Education */}
          <section class="space-y-2 pt-2 border-t border-slate-200">
            <div class="flex items-center gap-1.5 border-b border-indigo-200 pb-1">
              <GraduationCap className="w-3.5 h-3.5 text-indigo-700" />
              <h2 class="text-[11px] font-black uppercase tracking-wider text-slate-900">
                Education
              </h2>
            </div>

            {education.map((edu) => (
              <div class="text-[9.5px] space-y-0.5 bg-slate-50 p-2.5 rounded-lg border border-slate-200">
                <div class="font-bold text-slate-900">{edu.degree}</div>
                <div class="text-indigo-700 font-medium">{edu.institution}</div>
                <div class="text-slate-500 text-[8.5px]">{edu.period} • Vilnius/Kaunas, Lithuania</div>
              </div>
            ))}
          </section>

          {/* Profile Links Box */}
          <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200 text-[9px] text-slate-600 space-y-1">
            <div class="font-bold text-slate-900 uppercase tracking-wider text-[9.5px]">Verified Links</div>
            <div>• Portfolio: <a href="https://vilghelm.eu" class="text-indigo-700 hover:underline">vilghelm.eu</a></div>
            <div>• GitHub: <a href={personal.contacts.github} class="text-indigo-700 hover:underline">github.com/igoriok1994</a></div>
            <div>• LinkedIn: <a href={personal.contacts.linkedin} class="text-indigo-700 hover:underline">linkedin.com/in/igor-vilghem</a></div>
          </div>
        </aside>

        {/* Right Column (65%) */}
        <div class="col-span-8 space-y-3.5 border-l border-slate-200 pl-4">
          
          {/* Role 2 (Part 2) Continued */}
          <section class="space-y-2">
            <div class="flex items-center gap-1.5 border-b border-indigo-200 pb-1">
              <Building className="w-3.5 h-3.5 text-indigo-700" />
              <h2 class="text-[11px] font-black uppercase tracking-wider text-slate-900">
                Commercial Experience (Continued)
              </h2>
            </div>

            <div class="space-y-1">
              <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
                  <span>{fullStackRole.role} — Core Development & Scalability</span>
                </h3>
                <span class="text-[9px] font-semibold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded">
                  2016 – 2024
                </span>
              </div>

              <ul class="space-y-1 pl-2 text-[9.5px] text-slate-700 leading-snug">
                {role2Part2.map((resp) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-indigo-600 font-bold shrink-0 mt-0.5">•</span>
                    <span>{resp}</span>
                  </li>
                ))}
              </ul>
            </div>
          </section>

          {/* Key Achievements */}
          <section class="space-y-2 pt-2 border-t border-slate-200">
            <div class="flex items-center gap-1.5 border-b border-indigo-200 pb-1">
              <Award className="w-3.5 h-3.5 text-indigo-700" />
              <h2 class="text-[11px] font-black uppercase tracking-wider text-slate-900">
                Key Engineering Achievements
              </h2>
            </div>

            <div class="space-y-1 text-[9.5px] text-slate-700">
              {achievements.map((item) => (
                <div class="flex items-start gap-1.5 leading-snug">
                  <CheckCircle2 className="w-3 h-3 text-emerald-600 shrink-0 mt-0.5" />
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </section>

        </div>

      </div>
    </div>

    {/* Footer Page 2 */}
    <footer class="pt-2 border-t border-slate-200 flex justify-between items-center text-[8.5px] text-slate-500">
      <span>Igor Vilghelm • Curriculum Vitae</span>
      <span>Page 2 of 2</span>
    </footer>
  </div>

  {/* Auto-trigger print when URL has ?auto=true */}
  <script is:inline>
    (function() {
      const params = new URLSearchParams(window.location.search);
      if (params.get('auto') === 'true') {
        const cleanUrl = window.location.pathname;
        window.history.replaceState({}, '', cleanUrl);

        const run = () => setTimeout(() => window.print(), 350);
        if (document.readyState === 'complete') run();
        else window.addEventListener('load', run);
      }
    })();
  </script>

</body>
</html>
